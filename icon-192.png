const fs = require('node:fs');
const vm = require('node:vm');
const assert = require('node:assert/strict');
const html = fs.readFileSync(require('node:path').join(__dirname, '../index.html'), 'utf8');
const start = html.indexOf('function stampSeconds(');
const end = html.indexOf('function autoStyle(', start);
assert.ok(start >= 0 && end > start, 'karaoke pure-function section found');
const source = html.slice(start, end) + `\nglobalThis.K = {stampSeconds,parseLrc,wordWeight,tokenizeWords,estimateWordTimes,splitIntoSyllables,renderSyllabicWord};`;
const context = {console, esc: value => String(value).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;')};
vm.createContext(context); vm.runInContext(source, context);
const K = context.K; let passed = 0;
function test(name, fn) { try { assert.ok(fn(), name); passed++; console.log('PASS', name); } catch (e) { console.error('FAIL', name, e.message); process.exitCode = 1; } }
const lines = K.parseLrc('[00:01.00]Первая строка\n[00:04.50]Вторая строка');
test('ordinary LRC parsed', () => lines.length === 2 && Math.abs(lines[0].t - 1) < .001);
test('repeated timestamps become separate lines', () => K.parseLrc('[00:01.00][00:02.00]повтор').length === 2);
test('word timing tags detected', () => K.parseLrc('[00:00.00]Привет <00:00.50>мир')[0].wordSynced);
test('long line has positive bounded word intervals', () => { const a=K.estimateWordTimes({t:2,text:'длинная строка '.repeat(80)},{t:12}); return a.length>=80 && a.every(w=>w.end>w.t) && a.at(-1).end<=12.001; });
test('line-only timing adapts to the interval before the next lyric', () => { const a=K.estimateWordTimes({t:1,text:'коротко'},{t:6}); return a.length===1 && Math.abs(a[0].end-5.7)<.001; });
test('short timestamp gaps are not shifted or made negative', () => { const a=K.estimateWordTimes({t:1,text:'короткая строка'},{t:2.2}); return a.length>0 && a.every(w=>w.end>w.t) && a.at(-1).end<=2.201; });
test('Russian words split into syllables', () => K.splitIntoSyllables('молоко').join('|')==='мо|ло|ко' && K.splitIntoSyllables('машина').join('|')==='ма|ши|на');
test('English words split into syllables', () => K.splitIntoSyllables('karaoke').join('|')==='ka|ra|o|ke');
test('one-vowel word stays one syllable', () => K.splitIntoSyllables('дом').join('|')==='дом');
test('character spans are generated and spaces preserved', () => { const h=K.renderSyllabicWord('молоко '); return (h.match(/class="kc"/g)||[]).length===6 && h.endsWith(' '); });
test('HTML-sensitive characters are escaped in syllable renderer', () => !K.renderSyllabicWord('<a>').includes('<span class="kc" data-char="0"><</span>'));
test('calculation weights are positive', () => ['ра','привет','123'].every(x=>K.wordWeight(x)>0));
test('word intervals are ordered', () => { const a=K.tokenizeWords('раз два три',0); return a.every((w,i)=>w.end>w.t && (!i||w.t>=a[i-1].t)); });
test('tenths timestamp parsed', () => Math.abs(K.stampSeconds(0,2,'5')-2.5)<.001);
test('empty LRC safe', () => K.parseLrc('').length===0);
console.log(`Core tests: ${passed}/15 passed`);
