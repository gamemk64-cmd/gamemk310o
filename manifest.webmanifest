/* Cinematic, audio-reactive karaoke layer. Kept separate so the player stays modular. */
(() => {
  'use strict';

  const overlay = document.getElementById('karaokeOverlay');
  if (!overlay) return;
  const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches === true;
  const fxButton = document.getElementById('karaokeFxToggle');
  const stage = document.getElementById('karaokeStage');
  const backdrop = document.getElementById('karaokeBackdrop');
  const FX_MODES = ['CINEMATIC', 'NEON', 'AURORA', 'PARTICLES', 'PULSE', 'DYNAMIC'];
  let fxMode = 'CINEMATIC';
  try {
    const saved = localStorage.getItem('karaoke-fx-style');
    if (FX_MODES.includes(saved)) fxMode = saved;
  } catch (_) {}

  const style = document.createElement('style');
  style.textContent = `
    #karaokeFxStyle { border: 1px solid #ffffff28; background: #10101bd9; color: #fff;
      border-radius: 999px; padding: 8px 12px; font: 700 11px/1.2 system-ui; cursor: pointer;
      letter-spacing: .08em; backdrop-filter: blur(12px); }
    #karaokeOverlay.fx-neon #karaokeStage::after { border-color: color-mix(in srgb, var(--kg) 70%, transparent); box-shadow: 0 0 36px color-mix(in srgb, var(--kg) 30%, transparent), inset 0 0 45px color-mix(in srgb, var(--kr) 18%, transparent); }
    #karaokeOverlay.fx-aurora::after { filter: hue-rotate(24deg) saturate(1.4); }
    #karaokeOverlay.fx-pulse #karaokeStage { transform: scale(var(--kr-pulse, 1)); }
    #karaokeOverlay.fx-dynamic #karaokeLines .kl.kr-impact { animation-duration: 520ms !important; }
    #karaokeBackdrop {
      will-change: transform;
      transform: translate3d(var(--kr-drift-x, 0px), var(--kr-drift-y, 0px), 0)
        scale(var(--kr-back-scale, 1.18)) rotate(var(--kr-drift-rot, 0deg));
    }
    #karaokeOverlay::after {
      background:
        radial-gradient(ellipse at 50% 44%, color-mix(in srgb, var(--kr) var(--kr-glow, 22%), transparent), transparent 62%),
        linear-gradient(180deg, #05050b38 0%, #05050b63 48%, #05050bd9 100%);
    }
    #karaokeStage::after {
      content: ""; position: absolute; inset: 5% 1.5%; border-radius: 48%;
      border: 1px solid color-mix(in srgb, var(--kr) 20%, transparent);
      box-shadow: inset 0 0 55px color-mix(in srgb, var(--kr) 7%, transparent),
                  0 0 55px color-mix(in srgb, var(--kg) 6%, transparent);
      opacity: var(--kr-stage-glow, .12); pointer-events: none; z-index: 0;
      transform: scale(var(--kr-stage-scale, 1));
    }
    #karaokeLines { perspective: 900px; transform-style: preserve-3d; }
    #karaokeLines .kl { transform-origin: 50% 50%; will-change: transform, filter, opacity; }
    #karaokeLines .kl.kr-impact {
      animation: krCinematicImpact 740ms cubic-bezier(.16,.8,.22,1) both !important;
    }
    #karaokeLines .kw.singing {
      transform: translateY(-.025em) scale(1.018);
      filter: drop-shadow(0 0 12px color-mix(in srgb, var(--kg) 48%, transparent));
    }
    #karaokeLines .kc { display: inline-block; transform-origin: 50% 88%; will-change: transform; }
    #karaokeLines .kc.singing {
      transform: translateY(-.075em) scale(1.075);
      text-shadow: 0 0 15px color-mix(in srgb, var(--kg) 72%, transparent),
                   0 0 31px color-mix(in srgb, var(--kr) 44%, transparent);
      animation: krGlyphAccent 190ms cubic-bezier(.2,.75,.25,1) both;
    }
    #karaokeProgress i { box-shadow: 0 0 var(--kr-progress-glow, 12px) var(--kg); }
    #karaokeFxToggle:not(.active) { background: #ffffff0c !important; color: #d3d3e1 !important; box-shadow: none !important; }
    #karaokeFxToggle.active { background: linear-gradient(110deg, var(--kr), var(--kg)) !important; color: #07070c !important; }
    @keyframes krCinematicImpact {
      0% { opacity: .35; filter: blur(8px); transform: translateY(10px) scale(.91) rotateX(9deg); text-shadow: 0 0 0 transparent; }
      38% { opacity: 1; filter: blur(0); transform: translateY(-5px) scale(1.065) rotateX(0); text-shadow: 0 0 34px color-mix(in srgb, var(--kr) 58%, transparent); }
      68% { transform: translateY(1px) scale(.995); }
      100% { opacity: 1; filter: none; transform: scale(calc(1.04 * var(--kr-pulse, 1))); }
    }
    @keyframes krGlyphAccent {
      0% { filter: brightness(1.8); }
      100% { filter: brightness(1.12); }
    }
    @media (max-width: 720px) {
      #karaokeStage::after { inset: 8% -15%; }
      #karaokeLines .kl.kr-impact { animation-duration: 620ms !important; }
    }
    @media (prefers-reduced-motion: reduce) {
      #karaokeLines .kl.kr-impact, #karaokeLines .kc.singing { animation: none !important; }
      #karaokeFxStyle { border: 1px solid #ffffff28; background: #10101bd9; color: #fff;
      border-radius: 999px; padding: 8px 12px; font: 700 11px/1.2 system-ui; cursor: pointer;
      letter-spacing: .08em; backdrop-filter: blur(12px); }
    #karaokeOverlay.fx-neon #karaokeStage::after { border-color: color-mix(in srgb, var(--kg) 70%, transparent); box-shadow: 0 0 36px color-mix(in srgb, var(--kg) 30%, transparent), inset 0 0 45px color-mix(in srgb, var(--kr) 18%, transparent); }
    #karaokeOverlay.fx-aurora::after { filter: hue-rotate(24deg) saturate(1.4); }
    #karaokeOverlay.fx-pulse #karaokeStage { transform: scale(var(--kr-pulse, 1)); }
    #karaokeOverlay.fx-dynamic #karaokeLines .kl.kr-impact { animation-duration: 520ms !important; }
    #karaokeBackdrop { transform: scale(1.18) !important; }
    }
  `;
  document.head.appendChild(style);

  const clamp = (n, min, max) => Math.min(max, Math.max(min, n));
  const rand = (min, max) => min + Math.random() * (max - min);
  const colorAlpha = (hex, alpha) => {
    const m = String(hex || '').match(/^#([\da-f]{6})$/i);
    if (!m) return `rgba(124,92,255,${alpha})`;
    const value = parseInt(m[1], 16);
    return `rgba(${(value >> 16) & 255},${(value >> 8) & 255},${value & 255},${alpha})`;
  };
  const state = { particles: [], last: 0, lastBurst: 0, lastLine: -99, width: 0, height: 0 };

  function seedParticles(w, h) {
    const count = clamp(Math.round(w / (w < 600 ? 15 : 12)), 44, 108);
    state.particles = Array.from({ length: count }, () => ({
      x: rand(0, w), y: rand(0, h), vx: rand(-.19, .19), vy: rand(-.55, -.12),
      r: rand(.55, 2.2), life: rand(18, 100), maxLife: 100, burst: false, hue: Math.random() < .5 ? 0 : 1
    }));
    state.width = w;
    state.height = h;
  }

  function triggerLine(index) {
    if (!Number.isFinite(index) || index < 0 || index === state.lastLine) return;
    state.lastLine = index;
    const lines = overlay.querySelectorAll('#karaokeLines .kl');
    lines.forEach(line => line.classList.remove('kr-impact'));
    const active = overlay.querySelector(`#karaokeLines .kl[data-i="${index}"]`);
    if (!active || reducedMotion) return;
    // Restart the keyframe cleanly on a newly sung line.
    void active.offsetWidth;
    active.classList.add('kr-impact');
  }

  function drawCinematic(frame) {
    const { ctx, w, h, now, level = 0, bass = 0, beat = 0, data = null,
      c1 = '#7c5cff', c2 = '#1ed760', lite = false, sourceTime = 0, playing = false } = frame || {};
    if (!ctx || !w || !h) return;
    if (state.width !== w || state.height !== h || !state.particles.length) seedParticles(w, h);

    const dt = state.last ? clamp((now - state.last) / 16.667, 0, 2.1) : 1;
    state.last = now;
    // Split analyser bins into bass / mids / treble; no waveform access is assumed for YouTube.
    let low = bass, mid = level, high = level;
    if (data && data.length) {
      const avgBand = (from, to) => {
        const a = Math.max(0, Math.min(data.length - 1, Math.floor(from * data.length)));
        const b = Math.max(a + 1, Math.min(data.length, Math.floor(to * data.length)));
        let sum = 0; for (let i = a; i < b; i++) sum += data[i] || 0;
        return sum / (b - a) / 255;
      };
      low = avgBand(0, .08); mid = avgBand(.08, .42); high = avgBand(.42, 1);
    }
    const mode = fxMode;
    overlay.classList.toggle('fx-neon', mode === 'NEON');
    overlay.classList.toggle('fx-aurora', mode === 'AURORA');
    overlay.classList.toggle('fx-pulse', mode === 'PULSE');
    overlay.classList.toggle('fx-dynamic', mode === 'DYNAMIC');
    const motionFactor = reducedMotion ? .12 : (playing ? 1 : .22);
    const energy = clamp((mid * 1.05 + low * .52 + high * .24) * motionFactor, 0, 1);
    const kick = reducedMotion || !playing ? 0 : clamp(Math.max(beat, low * .7), 0, 1);
    const time = (playing && Number.isFinite(sourceTime) ? sourceTime * 1000 : now * .35);
    const cx = w * .5;
    const cy = h * .475;
    const unit = Math.min(w, h);
    const outer = unit * (.205 + energy * .025 + kick * .035);

    // Color fields move independently, making the cover art feel alive rather than merely blurred.
    ctx.save();
    ctx.globalCompositeOperation = 'screen';
    let glow = ctx.createRadialGradient(cx + Math.sin(time * .00023) * w * .15, cy - h * .04, 2,
      cx, cy, unit * (.2 + energy * .16 + kick * .07));
    glow.addColorStop(0, colorAlpha(c1, .095 + energy * .105 + kick * .07));
    glow.addColorStop(.46, colorAlpha(c2, .035 + energy * .045));
    glow.addColorStop(1, colorAlpha(c1, 0));
    ctx.fillStyle = glow;
    ctx.fillRect(0, 0, w, h);

    if (!lite) {
      // Four slow-orbiting rings with a small bass-responsive expansion.
      for (let ring = 0; ring < 4; ring++) {
        const radius = outer * (.58 + ring * .19) + Math.sin(time * .0011 + ring * 1.7) * (2 + energy * 8);
        ctx.beginPath();
        ctx.setLineDash(ring % 2 ? [2, 10] : [8, 13]);
        ctx.lineDashOffset = -time * (.004 + ring * .0015) * (ring % 2 ? -1 : 1);
        ctx.lineWidth = .65 + energy * .7 + kick * 1.1;
        ctx.strokeStyle = ring % 2 ? colorAlpha(c2, .065 + energy * .09 + kick * .12) : colorAlpha(c1, .07 + energy * .1 + kick * .12);
        ctx.beginPath();
        ctx.arc(cx, cy, Math.max(14, radius), time * .0002 + ring, Math.PI * 1.85 + time * .0002 + ring);
        ctx.stroke();
      }
      ctx.setLineDash([]);

      // A 360-degree spectrum halo. For local audio its height comes from the real analyser;
      // when the source blocks Web Audio, it gracefully follows the playback clock instead.
      const count = w < 520 ? 54 : 88;
      for (let i = 0; i < count; i++) {
        const angle = (i / count) * Math.PI * 2 + time * .000045;
        let value;
        if (data && data.length) {
          const pos = Math.min(data.length - 1, Math.floor(Math.pow(i / count, 1.72) * data.length));
          value = (data[pos] || 0) / 255;
        } else {
          const beatPhase = sourceTime * 2 * Math.PI * 1.8;
          value = .06 + .16 * Math.abs(Math.sin(angle * 3 + beatPhase)) + .09 * Math.abs(Math.sin(angle * 7 - beatPhase * .55));
        }
        const innerR = outer + 3;
        const length = 2 + value * unit * .075 + kick * unit * .035;
        ctx.beginPath();
        ctx.moveTo(cx + Math.cos(angle) * innerR, cy + Math.sin(angle) * innerR);
        ctx.lineTo(cx + Math.cos(angle) * (innerR + length), cy + Math.sin(angle) * (innerR + length));
        ctx.lineWidth = i % 4 === 0 ? 1.7 : .8;
        ctx.lineCap = 'round';
        ctx.strokeStyle = i % 3 === 0 ? colorAlpha(c2, .10 + value * .23 + kick * .11) : colorAlpha(c1, .07 + value * .21 + kick * .1);
        ctx.stroke();
      }

      // Three silk-like frequency ribbons drift around the lyrics without covering the words.
      const samples = clamp(Math.floor(w / 8), 44, 140);
      for (let row = 0; row < 3; row++) {
        const yBase = h * (.24 + row * .255);
        const phase = time * (.0006 + row * .00013) + row * 2.2;
        ctx.beginPath();
        for (let i = 0; i <= samples; i++) {
          const x = (i / samples) * w;
          const f = i / samples;
          let v;
          if (data && data.length) {
            const ix = Math.min(data.length - 1, Math.floor(Math.pow(f, 1.6) * data.length));
            v = data[ix] / 255;
          } else v = .11 + .16 * Math.abs(Math.sin(phase + f * 11));
          const wave = Math.sin(f * 16 + phase) * (3 + energy * 13) + Math.cos(f * 29 - phase * .8) * (1 + v * 8);
          const y = yBase + wave + (v - .18) * h * (.09 + energy * .055);
          if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.lineWidth = row === 1 ? 1.2 : .7;
        ctx.strokeStyle = row === 1 ? colorAlpha(c2, .09 + energy * .12 + kick * .1) : colorAlpha(c1, .055 + energy * .09);
        ctx.stroke();
      }

      // Short light rays bloom on strong transients, never a full-screen white flash.
      if (kick > .05) {
        const rayCount = 22;
        const rayReach = outer * (1.25 + kick * .38);
        const innerR = outer * .78;
        ctx.lineWidth = .7;
        for (let i = 0; i < rayCount; i++) {
          const a = (Math.PI * 2 * i / rayCount) + time * .00015;
          ctx.beginPath();
          ctx.moveTo(cx + Math.cos(a) * innerR, cy + Math.sin(a) * innerR);
          ctx.lineTo(cx + Math.cos(a) * rayReach, cy + Math.sin(a) * rayReach);
          ctx.strokeStyle = colorAlpha(i % 2 ? c1 : c2, kick * (.025 + (i % 4) * .008));
          ctx.stroke();
        }
      }
    }

    // Mode-specific signature layer. All motion is derived from the current frame/audio envelope.
    if (!lite && mode === 'NEON') {
      ctx.save(); ctx.globalCompositeOperation = 'screen';
      for (let i = 0; i < 3; i++) {
        const r = outer * (1.08 + i * .18 + energy * .08);
        ctx.beginPath(); ctx.arc(cx, cy, r, time * .00015 + i, time * .00015 + i + Math.PI * (1.15 + energy * .25));
        ctx.lineWidth = 1.2 + kick * 2 + high * 1.4;
        ctx.strokeStyle = colorAlpha(i % 2 ? c2 : c1, .22 + energy * .25);
        ctx.shadowBlur = 12 + energy * 22; ctx.shadowColor = i % 2 ? c2 : c1; ctx.stroke();
      } ctx.restore();
    } else if (!lite && mode === 'AURORA') {
      ctx.save(); ctx.globalCompositeOperation = 'screen';
      for (let band = 0; band < 4; band++) {
        ctx.beginPath();
        for (let i = 0; i <= 48; i++) {
          const x = i / 48 * w, f = i / 48;
          const y = h * (.16 + band * .12) + Math.sin(f * 8 + time * .00045 + band) * (10 + energy * 28)
            + Math.sin(f * 19 - time * .00025) * 5;
          if (!i) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.lineWidth = 5 + energy * 10 + high * 3; ctx.strokeStyle = colorAlpha(band % 2 ? c2 : c1, .025 + energy * .07);
        ctx.shadowBlur = 18; ctx.shadowColor = band % 2 ? c2 : c1; ctx.stroke();
      } ctx.restore();
    } else if (!lite && mode === 'PULSE') {
      ctx.beginPath(); ctx.arc(cx, cy, outer * (1.05 + kick * .22), 0, Math.PI * 2);
      ctx.lineWidth = 2 + kick * 4; ctx.strokeStyle = colorAlpha(c2, .12 + energy * .24 + kick * .25); ctx.stroke();
    }
    // PARTICLES mode uses the existing bounded particle pool without adding per-frame allocations.
    // Ambient dust and beat-burst particles; limited count for phones and lower-power devices.
    if (!lite && !reducedMotion && (mode === 'PARTICLES' || mode === 'CINEMATIC' || mode === 'DYNAMIC' || mode === 'AURORA')) {
      if (kick > .56 && now - state.lastBurst > 190) {
        state.lastBurst = now;
        let emitted = 0;
        for (const p of state.particles) {
          if (emitted >= 8 + Math.round(kick * 9)) break;
          if (!p.burst || p.life < 5) {
            const a = rand(0, Math.PI * 2);
            p.x = cx + Math.cos(a) * outer * .35;
            p.y = cy + Math.sin(a) * outer * .35;
            p.vx = Math.cos(a) * rand(.45, 1.65);
            p.vy = Math.sin(a) * rand(.45, 1.65);
            p.r = rand(.8, 2.5); p.life = p.maxLife = rand(25, 58); p.burst = true; p.hue = Math.random() < .5 ? 0 : 1;
            emitted++;
          }
        }
      }
      for (const p of state.particles) {
        p.life -= dt;
        if (p.burst) {
          p.x += p.vx * dt * (1 + kick * .65);
          p.y += p.vy * dt * (1 + kick * .65);
          p.vx *= .994; p.vy *= .994;
        } else {
          p.x += (p.vx + Math.sin(time * .0007 + p.y * .013) * .12) * dt;
          p.y += p.vy * dt * (1 + energy * .9);
        }
        if (p.life <= 0 || p.x < -8 || p.x > w + 8 || p.y < -8 || p.y > h + 8) {
          p.x = rand(0, w); p.y = rand(h * .32, h + 8); p.vx = rand(-.2, .2); p.vy = rand(-.58, -.14);
          p.life = p.maxLife = rand(35, 100); p.r = rand(.55, 1.8); p.burst = false; p.hue = Math.random() < .5 ? 0 : 1;
        }
        const alpha = clamp(p.life / Math.max(1, p.maxLife), 0, 1) * (p.burst ? .5 + kick * .3 : .25 + energy * .42);
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r + (p.burst ? kick * .7 : 0), 0, Math.PI * 2);
        ctx.fillStyle = colorAlpha(p.hue ? c2 : c1, alpha); ctx.fill();
      }
    }
    ctx.restore();

    // Small CSS-driven parallax binds the blurred artwork and frame glow to the same audio envelope.
    overlay.style.setProperty('--kr-energy', energy.toFixed(3));
    overlay.style.setProperty('--kr-progress-glow', `${(12 + energy * 22 + kick * 8).toFixed(1)}px`);
    overlay.style.setProperty('--kr-glow', `${clamp(17 + energy * 27 + kick * 18, 17, 58).toFixed(1)}%`);
    overlay.style.setProperty('--kr-stage-glow', clamp(.075 + energy * .16 + kick * .11, .06, .32).toFixed(3));
    overlay.style.setProperty('--kr-stage-scale', (1 + energy * .012 + kick * .018).toFixed(3));
    if (backdrop && !reducedMotion) {
      backdrop.style.setProperty('--kr-drift-x', `${Math.sin(time * .00016) * (4 + energy * 9 + kick * 12).toFixed(2)}px`);
      backdrop.style.setProperty('--kr-drift-y', `${Math.cos(time * .00019) * (3 + energy * 7 + kick * 9).toFixed(2)}px`);
      backdrop.style.setProperty('--kr-back-scale', (1.18 + energy * .025 + kick * .018).toFixed(3));
      backdrop.style.setProperty('--kr-drift-rot', `${Math.sin(time * .00013) * (energy * .45 + kick * .3).toFixed(3)}deg`);
    }
  }

  window.__karaokeCinematicFrame = drawCinematic;
  window.__karaokeCinematicLine = triggerLine;

  // A single delegated mode control avoids duplicate listeners when the overlay is reopened.
  if (fxButton && !document.getElementById('karaokeFxStyle')) {
    const modeButton = document.createElement('button');
    modeButton.id = 'karaokeFxStyle';
    modeButton.type = 'button';
    modeButton.textContent = 'FX: ' + fxMode;
    modeButton.title = 'Сменить кинематографический режим';
    modeButton.setAttribute('aria-label', 'Сменить режим визуальных эффектов');
    fxButton.insertAdjacentElement('afterend', modeButton);
    const applyMode = () => {
      FX_MODES.forEach(name => overlay.classList.toggle('fx-' + name.toLowerCase(), name === fxMode));
      modeButton.textContent = 'FX: ' + fxMode;
      modeButton.setAttribute('aria-label', 'Режим эффектов: ' + fxMode + '. Нажмите для переключения');
    };
    applyMode();
    modeButton.addEventListener('click', () => {
      fxMode = FX_MODES[(FX_MODES.indexOf(fxMode) + 1) % FX_MODES.length];
      try { localStorage.setItem('karaoke-fx-style', fxMode); } catch (_) {}
      applyMode();
    });
  }

  if (fxButton) {
    try { if (localStorage.getItem('karaoke-fx-mode') === 'lite') overlay.classList.add('fx-lite'); } catch (_) {}
    const refreshButton = () => {
      const max = !overlay.classList.contains('fx-lite');
      fxButton.classList.toggle('active', max);
      fxButton.setAttribute('aria-pressed', String(max));
      fxButton.textContent = max ? '✦ FX MAX' : 'FX LITE';
      fxButton.title = max ? 'Много аудиореактивных эффектов включено' : 'Упрощённые эффекты — меньше нагрузки';
    };
    refreshButton();
    fxButton.addEventListener('click', () => {
      overlay.classList.toggle('fx-lite');
      try { localStorage.setItem('karaoke-fx-mode', overlay.classList.contains('fx-lite') ? 'lite' : 'max'); } catch (_) {}
      refreshButton();
    });
  }
})();
